pcase
(let ((exp   (head args))
      (cases (tail args))
      (num-cases (len cases))
      (go (lambda (i)
            (if (>= i num-cases)
                nil
                (let ((cs (get cases i))
                      (pat (get cs 0))
                      (res (get cs 1)))
                  `(try
                    (let ,($codeutils:make-extractor pat exp)
                      ,res)
                    (if (erristype error E_BOUNDS)
                        ,(go (+ i 1))
                        (err error))))))))
  (go 0))
