;;; ($objutils:is-descendant ancestor obj)
;;;
;;; Returns 1 whether `ancestor` has `obj` as a  descendant, 0 otherwise.
(define go
  (lambda (ancestor obj)
    (cond
     ((= ancestor obj) 1)
     ((= obj (parent obj)) 0)
     ((go ancestor (parent obj))))))

